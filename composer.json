{
	"name": "lab123/lumen-notification",
	"type": "library",
	"description": "Laravel Notifications wiring for Illuminate-based apps (ex-Lumen): service provider, mail/services config and artisan commands",
	"keywords": [
		"lumen",
		"laravel",
		"notification",
		"laravel-notification",
		"lumen-notification",
		"wrapper"
	],
	"homepage": "https://github.com/lab123it/lumen-notification",
	"license": "MIT",
	"authors": [
		{
			"name": "Jean Pierre",
			"email": "jean.pierre@lab123.com.br"
		}
	],
	"autoload": {
		"psr-4": {
			"LumenNotification\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"LumenNotification\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": "^8.1",
		"illuminate/console": "^10.0|^11.0|^12.60|^13.10",
		"illuminate/database": "^10.0|^11.0|^12.60|^13.10",
		"illuminate/filesystem": "^10.0|^11.0|^12.60|^13.10",
		"illuminate/mail": "^10.0|^11.0|^12.60|^13.10",
		"illuminate/notifications": "^10.0|^11.0|^12.60|^13.10",
		"illuminate/support": "^10.0|^11.0|^12.60|^13.10"
	},
	"require-dev": {
		"orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
		"phpunit/phpunit": "^10.5|^11.5|^12.0"
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true,
		"policy": {
			"advisories": {
				"block": false
			}
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
